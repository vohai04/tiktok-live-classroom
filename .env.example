# Render Docker sets CLASSROOM_CLOUD and CLASSROOM_TTS automatically.
CLASSROOM_CLOUD=1
ADMIN_PASSWORD=replace-with-your-own-password-at-least-12-characters
# Render supplies RENDER_EXTERNAL_URL automatically. For other hosts:
# CLASSROOM_PUBLIC_URL=https://your-service.onrender.com
CLASSROOM_TTS=edge
CLASSROOM_VOICE=vi-VN-HoaiMyNeural
# Optional durable question history (use your own Upstash Redis Free database):
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-private-rest-token
# Never commit the real .env file. Native Node startup reads actual environment
# variables; this file is a template, not loaded automatically.
